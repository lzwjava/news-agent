# LLM provider used for the digest step.
# One of: openrouter | deepseek | openai | custom
NEWS_AGENT_PROVIDER=openrouter

# Model name (defaults: openai/gpt-4o-mini on openrouter, deepseek-chat on deepseek)
NEWS_AGENT_MODEL=

# Keys (only the one for the selected provider is needed)
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# For NEWS_AGENT_PROVIDER=custom (any OpenAI-compatible endpoint)
NEWS_AGENT_BASE_URL=
NEWS_AGENT_API_KEY=

# Optional overrides
# NEWS_AGENT_SOURCES=/path/to/sources.yaml
# NEWS_AGENT_OUT=/path/to/output